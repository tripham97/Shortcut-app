{
  "name": "shortcut-app",
  "version": "1.0.1",
  "description": "A keyboard-first quick search and app launcher for Windows/ Mac.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "xattr -cr assets index.html main.js package.json preload.js renderer.js styles.css && electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "launcher",
    "search",
    "windows"
  ],
  "author": "Lemontri",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.shortcutapp.launcher",
    "productName": "Shortcut App",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "notarize": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
